# Python environments and generated files
AI/.venv/
AI/.pytest_cache/
AI/**/__pycache__/
AI/**/*.pyc
AI/.env
AI/.env.*
!AI/.env.example

# Supervisor pipeline run artifacts (per-run data, not source)
AI/app/storage/runs/
AI/app/agents/*/outputs/latest/
AI/app/agents/*/outputs/*/checkpoints/

# Local IDE and OS files
.vscode/*
!.vscode/
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json
.idea/
*.iml
.DS_Store
Thumbs.db
# Node.js dependencies and generated output
testing/node_modules/
testing/out/
testing/build/
testing/.gradle/
testing/target/
# Test case generator per-module cache
AI/app/agents/test_case_generator/outputs/**/.module_cache/
